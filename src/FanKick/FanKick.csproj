<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FanKick</AssemblyName>
    <RootNamespace>FanKick</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Shown by Windows as the file's publisher and description (Task Manager, Properties, Apps). -->
    <Product>FanKick</Product>
    <AssemblyTitle>FanKick</AssemblyTitle>
    <Description>Fan and thermal control for Windows, macOS and Linux.</Description>
    <Company>harshal.dev</Company>
    <Authors>harshal.dev</Authors>
    <Copyright>Copyright (c) 2026 Harshal Narkhede (harshal.dev). MIT License.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fankick.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibreHardwareMonitor uses reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="FanKick.Tests" />
  </ItemGroup>
</Project>
